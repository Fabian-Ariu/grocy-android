<?xml version="1.0" encoding="utf-8"?>
<!-- Vorlage: Listenzeilen als Glas-Karten. Aufbau wie ripple_list_item_swipeable,
     nur die Zeilenflaeche ist eine durchscheinende Glas-Karte statt colorSurface. -->
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:autoMirrored="true">
  <item
    android:top="1dp"
    android:bottom="1dp">
    <shape android:shape="rectangle">
      <solid android:color="@android:color/transparent" />
      <corners
        android:topLeftRadius="16dp"
        android:bottomLeftRadius="16dp" />
    </shape>
  </item>
  <item>
    <ripple android:color="@color/selector_highlight">
      <item
        android:left="16dp"
        android:right="16dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
          <corners android:radius="16dp" />
          <gradient android:angle="225" android:startColor="#D9FFFFFF" android:endColor="#99FFFFFF" />
          <stroke android:width="1dp" android:color="#14000000" />
        </shape>
      </item>
    </ripple>
  </item>
</layer-list>
