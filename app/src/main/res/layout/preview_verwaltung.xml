<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="start|top"
      android:layout_marginStart="-100dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_blue" />
  <View android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="end|bottom"
      android:layout_marginEnd="-90dp" android:layout_marginBottom="120dp" android:background="@drawable/blob_green" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_circle" android:tag="preview_mehr" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_arrow_back" app:tint="#0062CC"/>
      </FrameLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Verwaltung" android:textColor="#1F1E1D" android:textSize="26sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:layout_marginTop="14dp" android:clipToPadding="false" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/glass_card" android:padding="16dp" android:tag="preview_server" android:clickable="true" android:focusable="true">
          <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/icon_circle_dark">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_round_inventory" app:tint="#FFFFFF"/>
            <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="end|top" android:background="@drawable/status_dot_green_ring"/>
          </FrameLayout>
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grocy-Server" android:textColor="#1F1E1D" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verbunden · Sync, Fernzugriff, Drucker" android:textColor="#6A6A6A" android:textSize="13sp"/>
          </LinearLayout>
          <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
        </LinearLayout>

        <TextView style="@style/PreviewSectionHeader" android:text="DATEN" android:layout_marginTop="18dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card">
          <LinearLayout style="@style/PreviewRow" android:tag="preview_stammdaten" android:clickable="true" android:focusable="true">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/icon_circle_blue"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_round_inventory" app:tint="#0062CC"/></FrameLayout>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Stammdaten &amp; Einheiten" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout style="@style/PreviewRow" android:tag="preview_quellen" android:clickable="true" android:focusable="true">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/icon_circle_green"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_round_widgets" app:tint="#1F7A4D"/></FrameLayout>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Online-Quellen" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 aktiv" android:textColor="#6A6A6A" android:textSize="14sp" android:layout_marginEnd="8dp"/>
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout style="@style/PreviewRow" android:tag="preview_benachrichtigungen" android:clickable="true" android:focusable="true">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/icon_circle_red"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_round_notification_important" app:tint="#E5484D"/></FrameLayout>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Benachrichtigungen" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
          </LinearLayout>
        </LinearLayout>

        <TextView style="@style/PreviewSectionHeader" android:text="DIESES GERÄT" android:layout_marginTop="18dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card">
          <LinearLayout style="@style/PreviewRow">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/icon_circle_dark"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_round_barcode" app:tint="#FFFFFF"/></FrameLayout>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Hardwaretasten" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scan · ± · PTT" android:textColor="#6A6A6A" android:textSize="14sp" android:layout_marginEnd="8dp"/>
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout style="@style/PreviewRow">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/icon_circle_blue"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_round_local_grocery_store" app:tint="#0062CC"/></FrameLayout>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Offline-Einkaufsliste" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <FrameLayout android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/toggle_on">
              <View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="3dp" android:background="@drawable/glass_circle"/>
            </FrameLayout>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout style="@style/PreviewRow">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/icon_circle_violet"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_round_widgets" app:tint="#7C5CFF"/></FrameLayout>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Darstellung" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Automatisch" android:textColor="#6A6A6A" android:textSize="14sp" android:layout_marginEnd="8dp"/>
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
          </LinearLayout>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

  </LinearLayout>
</FrameLayout>
