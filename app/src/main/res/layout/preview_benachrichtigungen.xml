<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="start|top"
      android:layout_marginStart="-100dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_orange" />
  <View android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="end|bottom"
      android:layout_marginEnd="-90dp" android:layout_marginBottom="140dp" android:background="@drawable/blob_blue" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_circle" android:tag="preview_verwaltung" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_arrow_back" app:tint="#0062CC"/>
      </FrameLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Benachrichtigungen" android:textColor="#1F1E1D" android:textSize="23sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:layout_marginTop="14dp" android:clipToPadding="false" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <TextView style="@style/PreviewSectionHeader" android:text="MELDEN, WENN"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card">
          <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bald fällig" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 Tage vorher" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <FrameLayout android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/toggle_on"><View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="3dp" android:background="@drawable/glass_circle"/></FrameLayout>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Abgelaufen" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Am Tag danach" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <FrameLayout android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/toggle_on"><View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="3dp" android:background="@drawable/glass_circle"/></FrameLayout>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unter Mindestmenge" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kommt auch auf die Einkaufsliste" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <FrameLayout android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/toggle_on"><View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="3dp" android:background="@drawable/glass_circle"/></FrameLayout>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hausarbeiten fällig" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nur wenn Modul eingeblendet" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <FrameLayout android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/toggle_off"><View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="3dp" android:background="@drawable/glass_circle"/></FrameLayout>
          </LinearLayout>
        </LinearLayout>

        <TextView style="@style/PreviewSectionHeader" android:text="ZUSTELLUNG ÜBER DEN SERVER" android:layout_marginTop="18dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card">
          <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wandpanel «Zuhause»" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:gravity="end" android:text="Hinweis, stummschaltbar" android:textColor="#6A6A6A" android:textSize="14sp"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Handys" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Push, Ruhezeit 21 bis 7 Uhr" android:textColor="#6A6A6A" android:textSize="14sp"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dieser Scanner" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nur Scan-Fehler" android:textColor="#6A6A6A" android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

  </LinearLayout>
</FrameLayout>
