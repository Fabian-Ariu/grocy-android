<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="start|top"
      android:layout_marginStart="-100dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_blue" />
  <View android:layout_width="300dp" android:layout_height="300dp" android:layout_gravity="end|bottom"
      android:layout_marginEnd="-90dp" android:layout_marginBottom="100dp" android:background="@drawable/blob_green" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_circle" android:tag="preview_geraete" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_arrow_back" app:tint="#0062CC"/>
      </FrameLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wartung anlegen" android:textColor="#1F1E1D" android:textSize="23sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kaffeemaschine · Küche" android:textColor="#6A6A6A" android:textSize="13sp"/>
      </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:layout_marginTop="14dp" android:clipToPadding="false" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="18dp" android:text="Entkalken" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/input_box"/>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginTop="12dp">
          <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Entkalken" android:textColor="#1F1E1D" android:textSize="14sp" android:background="@drawable/glass_pill" android:layout_marginEnd="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Brühgruppe reinigen" android:textColor="#1F1E1D" android:textSize="14sp" android:background="@drawable/glass_pill" android:layout_marginEnd="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Wasserfilter" android:textColor="#1F1E1D" android:textSize="14sp" android:background="@drawable/glass_pill"/>
          </LinearLayout>
        </HorizontalScrollView>

        <TextView style="@style/PreviewSectionHeader" android:text="RHYTHMUS LAUT HERSTELLER" android:layout_marginTop="16dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:background="@drawable/glass_pill" android:padding="4dp">
          <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Ab letzter Wartung" android:textColor="#1F1E1D" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/white_chip"/>
          <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Fester Termin" android:textColor="#5A5F6A" android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:background="@drawable/glass_card" android:paddingStart="18dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Alle" android:textColor="#1F1E1D" android:textSize="17sp"/>
          <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="–" android:textColor="#3A3F4A" android:textSize="22sp" android:background="@drawable/stepper_light"/>
          <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="center" android:text="90" android:textColor="#1F1E1D" android:textSize="22sp" android:textStyle="bold"/>
          <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/blue_fab"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
          <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="Tage" android:textColor="#0062CC" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/chip_blue_selected" android:layout_marginEnd="10dp"/>
          <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="Wochen" android:textColor="#1F1E1D" android:textSize="15sp" android:background="@drawable/glass_pill" android:layout_marginEnd="10dp"/>
          <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="Monate" android:textColor="#1F1E1D" android:textSize="15sp" android:background="@drawable/glass_pill"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginTop="14dp" android:background="@drawable/input_box">
          <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_round_edit" app:tint="#8A8F98"/>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Fundstelle, z. B. Anleitung S. 24" android:textColor="#8A8A8A" android:textSize="16sp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:text="Entkalken alle 90 Tage, gezählt ab der letzten Wartung. Fällig erscheint es auf dem Wandpanel und in den Erinnerungen." android:textColor="#6A6A6A" android:textSize="14sp" android:lineSpacingExtra="3dp"/>

      </LinearLayout>
    </ScrollView>

    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:tag="preview_geraete" android:clickable="true" android:focusable="true" android:layout_marginTop="4dp"
        android:text="Wartung speichern" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/blue_primary"/>

  </LinearLayout>
</FrameLayout>
