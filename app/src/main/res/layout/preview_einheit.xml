<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="start|top"
      android:layout_marginStart="-100dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_blue" />
  <View android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="end|bottom"
      android:layout_marginEnd="-90dp" android:layout_marginBottom="100dp" android:background="@drawable/blob_orange" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_circle" android:tag="preview_stammdaten" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_arrow_back" app:tint="#0062CC"/>
      </FrameLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Packung" android:textColor="#1F1E1D" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Einheit" android:textColor="#6A6A6A" android:textSize="13sp"/>
      </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:layout_marginTop="14dp" android:clipToPadding="false" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card">
          <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Einzahl" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Packung" android:textColor="#6A6A6A" android:textSize="16sp"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mehrzahl" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Packungen" android:textColor="#6A6A6A" android:textSize="16sp"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kurzform" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pkg." android:textColor="#6A6A6A" android:textSize="16sp"/>
          </LinearLayout>
        </LinearLayout>

        <TextView style="@style/PreviewSectionHeader" android:text="UMRECHNUNG JE PRODUKT" android:layout_marginTop="18dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card">
          <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Haferflocken" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 Pkg. = 500 g" android:textColor="#6A6A6A" android:textSize="15sp"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Reis" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 Pkg. = 1 kg" android:textColor="#6A6A6A" android:textSize="15sp"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Linsen" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 Pkg. = 500 g" android:textColor="#6A6A6A" android:textSize="15sp"/>
          </LinearLayout>
        </LinearLayout>

        <TextView style="@style/PreviewSectionHeader" android:text="NEU: 1 PKG. MEHL =" android:layout_marginTop="18dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
          <TextView android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="18dp" android:text="1000" android:textColor="#1F1E1D" android:textSize="20sp" android:textStyle="bold" android:background="@drawable/input_box" android:layout_marginEnd="10dp"/>
          <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="g" android:textColor="#0062CC" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/chip_blue_selected" android:layout_marginEnd="8dp"/>
          <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="kg" android:textColor="#1F1E1D" android:textSize="16sp" android:background="@drawable/glass_pill" android:layout_marginEnd="8dp"/>
          <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="Stk." android:textColor="#1F1E1D" android:textSize="16sp" android:background="@drawable/glass_pill"/>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:tag="preview_stammdaten" android:clickable="true" android:focusable="true" android:layout_marginTop="4dp"
        android:text="Umrechnung speichern" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/blue_primary"/>

  </LinearLayout>
</FrameLayout>
