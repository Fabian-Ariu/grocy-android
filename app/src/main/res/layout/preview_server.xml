<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="start|top"
      android:layout_marginStart="-100dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_blue" />
  <View android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="end|bottom"
      android:layout_marginEnd="-90dp" android:layout_marginBottom="120dp" android:background="@drawable/blob_green" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_circle" android:tag="preview_verwaltung" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_arrow_back" app:tint="#0062CC"/>
      </FrameLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Server &amp; Sync" android:textColor="#1F1E1D" android:textSize="26sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:layout_marginTop="14dp" android:clipToPadding="false" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <View android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/status_dot_green"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grocy 4.7.1 verbunden" android:textColor="#1F1E1D" android:textSize="18sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Letzter Abgleich vor 1 Minute" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
          </LinearLayout>
          <TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:layout_marginTop="14dp"
              android:text="Verbindung testen" android:textColor="#0062CC" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/blue_soft"/>
        </LinearLayout>

        <TextView style="@style/PreviewSectionHeader" android:text="WARTESCHLANGE" android:layout_marginTop="18dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card">
          <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Passata" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verbraucht · Keller · vor 4 Min." android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="−1" android:textColor="#C8781E" android:textSize="18sp" android:textStyle="bold"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zwetschgenmus" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eingelegt · Keller · vor 3 Min." android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+4" android:textColor="#0062CC" android:textSize="18sp" android:textStyle="bold"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Linsen" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inventur · Keller · vor 2 Min." android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="= 4" android:textColor="#6A6A6A" android:textSize="18sp" android:textStyle="bold"/>
          </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:layout_marginTop="14dp"
            android:text="Jetzt senden" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/blue_primary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:paddingStart="4dp"
            android:text="Wird automatisch gesendet, sobald das WLAN wieder da ist." android:textColor="#6A6A6A" android:textSize="14sp"/>

        <TextView style="@style/PreviewSectionHeader" android:text="VERBINDUNG" android:layout_marginTop="18dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card">
          <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Im Heimnetz" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="[LAN-Adresse]:[Port]" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Unterwegs über Cloudflare" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
            <FrameLayout android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/toggle_off">
              <View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="3dp" android:background="@drawable/glass_circle"/>
            </FrameLayout>
          </LinearLayout>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

  </LinearLayout>
</FrameLayout>
