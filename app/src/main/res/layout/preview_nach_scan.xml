<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="end|top"
      android:layout_marginEnd="-110dp" android:layout_marginTop="-20dp" android:background="@drawable/blob_blue" />
  <View android:layout_width="300dp" android:layout_height="300dp" android:layout_gravity="start|bottom"
      android:layout_marginStart="-90dp" android:layout_marginBottom="80dp" android:background="@drawable/blob_orange" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="16dp">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center"
        android:paddingStart="12dp" android:paddingEnd="18dp" android:background="@drawable/glass_pill" android:tag="preview_home" android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_round_expand_more" app:tint="#0062CC" android:rotation="90"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Abbrechen" android:textColor="#0062CC" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Produktkarte -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:background="@drawable/glass_card" android:padding="16dp" android:layout_marginTop="14dp">
      <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/glass_chip">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_round_inventory" app:tint="#3A3F4A"/>
      </FrameLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Haferflocken" android:textColor="#1F1E1D" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500 g · 3 Pkg. in Vorratskammer" android:textColor="#6A6A6A" android:textSize="14sp"/>
      </LinearLayout>
    </LinearLayout>

    <TextView style="@style/PreviewSectionHeader" android:text="WAS MÖCHTEST DU TUN?" android:layout_marginTop="18dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="16dp" android:layout_marginEnd="12dp" android:tag="preview_home" android:clickable="true" android:focusable="true">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/icon_circle_blue"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_add_shopping_cart" app:tint="#0062CC"/></FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Einlagern" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="16dp" android:tag="preview_home" android:clickable="true" android:focusable="true">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/icon_circle_orange"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_restaurant_menu" app:tint="#C8781E"/></FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Verbrauchen" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
      </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="16dp" android:layout_marginEnd="12dp" android:tag="preview_home" android:clickable="true" android:focusable="true">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/icon_circle_violet"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_swap_horiz" app:tint="#7C5CFF"/></FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Umlagern" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="16dp" android:tag="preview_home" android:clickable="true" android:focusable="true">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/icon_circle_blue"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_inventory" app:tint="#0062CC"/></FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Inventur" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
      </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="16dp" android:layout_marginEnd="12dp" android:tag="preview_home" android:clickable="true" android:focusable="true">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/icon_circle_brown"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_inventory" app:tint="#8A5A00"/></FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Geöffnet" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="16dp" android:tag="preview_einkauf" android:clickable="true" android:focusable="true">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/icon_circle_green"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_local_grocery_store" app:tint="#1F7A4D"/></FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Einkaufsliste" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
      </LinearLayout>
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:orientation="horizontal"
        android:gravity="center" android:paddingStart="14dp" android:paddingEnd="16dp" android:background="@drawable/glass_chip">
      <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_round_barcode" app:tint="#6A6A6A"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Taste erneut: " android:textColor="#6A6A6A" android:textSize="14sp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Einlagern ×1" android:textColor="#1F1E1D" android:textSize="14sp" android:textStyle="bold"/>
    </LinearLayout>

  </LinearLayout>
</FrameLayout>
