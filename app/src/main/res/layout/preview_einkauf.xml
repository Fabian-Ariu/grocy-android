<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F2F0EB">

  <View android:layout_width="300dp" android:layout_height="300dp"
      android:layout_gravity="start|top" android:layout_marginStart="-90dp" android:layout_marginTop="-20dp"
      android:background="@drawable/blob_green" />
  <View android:layout_width="300dp" android:layout_height="300dp"
      android:layout_gravity="end|bottom" android:layout_marginEnd="-110dp" android:layout_marginBottom="80dp"
      android:background="@drawable/blob_blue" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
      android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Einkauf" android:textColor="#1F1E1D" android:textSize="30sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
          <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_round_swap_horiz" app:tint="#6A6A6A"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Sync mit Erinnerungen" android:textColor="#6A6A6A" android:textSize="13sp"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:orientation="horizontal"
          android:gravity="center" android:paddingStart="14dp" android:paddingEnd="16dp" android:background="@drawable/glass_pill">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_round_local_grocery_store" app:tint="#3A3F4A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Geschäft" android:textColor="#3A3F4A" android:textSize="15sp"/>
      </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="6dp" android:background="@drawable/glass_pill">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
          android:text="Hinzufügen oder scannen" android:textColor="#8A8A8A" android:textSize="16sp"/>
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/blue_circle">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_round_add_anim" app:tint="#FFFFFF"/>
      </FrameLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scrollbars="none" android:layout_marginTop="8dp" android:clipToPadding="false" android:paddingBottom="12dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <TextView style="@style/PreviewSectionHeader" android:text="WOCHENMARKT"/>
        <LinearLayout style="@style/PreviewGroupCard">
          <LinearLayout style="@style/PreviewRow">
            <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/checkbox_ring" android:layout_marginEnd="14dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bananen" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Obst &amp; Gemüse" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 kg" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout style="@style/PreviewRow">
            <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/checkbox_ring" android:layout_marginEnd="14dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zwiebeln" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Obst &amp; Gemüse · Für Linsencurry" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 kg" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
          </LinearLayout>
        </LinearLayout>

        <TextView style="@style/PreviewSectionHeader" android:text="SUPERMARKT"/>
        <LinearLayout style="@style/PreviewGroupCard">
          <LinearLayout style="@style/PreviewRow">
            <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/checkbox_ring" android:layout_marginEnd="14dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Butter" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Milchprodukte" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 Stk." android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout style="@style/PreviewRow">
            <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/checkbox_ring" android:layout_marginEnd="14dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reis" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vorrat · Automatisch · unter Mindestmenge" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 Pkg." android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout style="@style/PreviewRow">
            <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/checkbox_ring" android:layout_marginEnd="14dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kaffeebohnen" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vorrat · Automatisch · unter Mindestmenge" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 kg" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
          </LinearLayout>
        </LinearLayout>

        <TextView style="@style/PreviewSectionHeader" android:text="DROGERIEMARKT"/>
        <LinearLayout style="@style/PreviewGroupCard">
          <LinearLayout style="@style/PreviewRow">
            <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/checkbox_ring" android:layout_marginEnd="14dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zahnpasta" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Drogerie" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 Tube" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
          </LinearLayout>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="74dp" android:orientation="horizontal"
        android:background="@drawable/glass_card" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:tag="preview_home" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_barcode_scan" app:tint="#5A5F6A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scannen" android:textSize="11sp" android:textColor="#5A5F6A"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:tag="preview_vorrat" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_inventory" app:tint="#5A5F6A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vorrat" android:textSize="11sp" android:textColor="#5A5F6A"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/glass_chip" android:tag="preview_einkauf" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_local_grocery_store" app:tint="#0062CC"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Einkauf" android:textSize="11sp" android:textColor="#0062CC"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:tag="preview_rezepte" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_restaurant_menu" app:tint="#5A5F6A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rezepte" android:textSize="11sp" android:textColor="#5A5F6A"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:tag="preview_mehr" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_widgets" app:tint="#5A5F6A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mehr" android:textSize="11sp" android:textColor="#5A5F6A"/>
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>
</FrameLayout>
