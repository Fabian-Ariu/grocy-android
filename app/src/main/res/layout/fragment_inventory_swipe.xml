<?xml version="1.0" encoding="utf-8"?>
<!-- Scanory: schnelle Inventur als Swipe-Stapel (Vorlage 08) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/relative" android:layout_width="match_parent" android:layout_height="match_parent">
  <com.google.android.material.appbar.AppBarLayout android:id="@+id/app_bar" android:background="@android:color/transparent" android:layout_width="match_parent" android:layout_height="wrap_content">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" style="@style/Widget.Grocy.Toolbar.Back" app:title="@string/title_inventory"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="6dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/glass_card">
      <TextView android:id="@+id/text_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" tools:text="2 von 6 geprueft"/>
      <FrameLayout android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp" android:background="@drawable/progress_track">
        <View android:id="@+id/progress_fill" android:layout_width="0dp" android:layout_height="8dp" android:background="@drawable/progress_fill"/>
      </FrameLayout>
    </LinearLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <FrameLayout android:id="@+id/container" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/app_bar" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="96dp" android:clipChildren="false" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical">
      <!-- Karte -->
      <FrameLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/kassen_green_bg" android:padding="16dp" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView style="@style/PreviewSectionHeader" android:text="@string/inv_scanned"/>
          <TextView android:id="@+id/text_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="24sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" tools:text="Passata"/>
          <TextView android:id="@+id/text_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="15sp" tools:text="Laut Grocy: 6 Glaeser"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
            <TextView android:id="@+id/button_minus" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="–" android:textColor="?attr/colorOnSurface" android:textSize="26sp" android:background="@drawable/stepper_light" android:clickable="true" android:focusable="true"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
              <TextView android:id="@+id/text_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="36sp" android:textStyle="bold" tools:text="6"/>
              <TextView android:id="@+id/text_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" tools:text="stimmt"/>
            </LinearLayout>
            <TextView android:id="@+id/button_plus" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="+" android:textColor="?attr/colorOnSurface" android:textSize="26sp" android:background="@drawable/stepper_light" android:clickable="true" android:focusable="true"/>
          </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/label_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="@string/inv_ok_label" android:textColor="?attr/colorSecondary" android:textSize="22sp" android:textStyle="bold" android:rotation="-12" android:alpha="0"/>
        <TextView android:id="@+id/label_gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:text="@string/inv_gone_label" android:textColor="?attr/colorError" android:textSize="22sp" android:textStyle="bold" android:rotation="12" android:alpha="0"/>
      </FrameLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <TextView android:id="@+id/button_gone" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:text="@string/inv_gone" android:textColor="?attr/colorError" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/glass_pill" android:layout_marginEnd="10dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/button_ok" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="2" android:gravity="center" android:text="@string/inv_ok" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/green_primary" android:clickable="true" android:focusable="true"/>
      </LinearLayout>
      <TextView android:id="@+id/button_undo" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="@string/action_undo" android:textColor="?attr/colorPrimary" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/glass_pill" android:visibility="invisible" android:clickable="true" android:focusable="true"/>
      <TextView android:id="@+id/text_done" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="40dp" android:textColor="?attr/colorOnSurface" android:textSize="20sp" android:textStyle="bold" android:text="@string/inv_finished" android:visibility="gone"/>
    </LinearLayout>
  </FrameLayout>
</RelativeLayout>
