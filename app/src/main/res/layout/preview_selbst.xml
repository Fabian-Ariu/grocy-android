<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="end|top"
      android:layout_marginEnd="-110dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_orange" />
  <View android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="start|bottom"
      android:layout_marginStart="-90dp" android:layout_marginBottom="120dp" android:background="@drawable/blob_blue" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_circle" android:tag="preview_home" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_arrow_back" app:tint="#0062CC"/>
      </FrameLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Selbstgemacht" android:textColor="#1F1E1D" android:textSize="26sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:layout_marginTop="14dp" android:clipToPadding="false" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/card_selected" android:layout_marginEnd="12dp">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/icon_circle_brown"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_round_inventory" app:tint="#8A5A00"/></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eingekocht" android:textColor="#8A5A00" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Konfitüre, Sirup" android:textColor="#6A6A6A" android:textSize="12sp"/>
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/glass_card">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/icon_circle_blue"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_round_widgets" app:tint="#0062CC"/></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eingefroren" android:textColor="#1F1E1D" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gerichte, Brühe" android:textColor="#6A6A6A" android:textSize="12sp"/>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/glass_card" android:layout_marginEnd="12dp">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/icon_circle_green"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_round_inventory" app:tint="#1F7A4D"/></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eingelegt" android:textColor="#1F1E1D" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Essig, Gärung, Öl" android:textColor="#6A6A6A" android:textSize="12sp"/>
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/glass_card">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/icon_circle_orange"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_round_restaurant_menu" app:tint="#C8781E"/></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Getrocknet" android:textColor="#1F1E1D" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dörrobst, Kräuter" android:textColor="#6A6A6A" android:textSize="12sp"/>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:background="@drawable/glass_pill">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Zwetschgenmus" android:textColor="#1F1E1D" android:textSize="16sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
          <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Zwetschgenmus" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/chip_dark" android:layout_marginEnd="10dp"/>
          <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Apfelmus" android:textColor="#1F1E1D" android:textSize="14sp" android:background="@drawable/glass_pill" android:layout_marginEnd="10dp"/>
          <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Tomatensugo" android:textColor="#1F1E1D" android:textSize="14sp" android:background="@drawable/glass_pill"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp" android:paddingStart="4dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gläser" android:textColor="#1F1E1D" android:textSize="18sp"/>
          <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="–" android:textColor="#3A3F4A" android:textSize="22sp" android:background="@drawable/stepper_light"/>
          <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="center" android:text="4" android:textColor="#1F1E1D" android:textSize="22sp" android:textStyle="bold"/>
          <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/circle_brown"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:background="@drawable/glass_card">
          <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ort" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keller" android:textColor="#6A6A6A" android:textSize="16sp"/>
          </LinearLayout>
          <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14000000"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Haltbar bis" android:textColor="#1F1E1D" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21.10.2027 · auto" android:textColor="#6A6A6A" android:textSize="15sp"/>
          </LinearLayout>
          <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14000000"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Etikett mit Code" android:textColor="#1F1E1D" android:textSize="16sp"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Später einfach scannen" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <FrameLayout android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/toggle_on">
              <View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="3dp" android:background="@drawable/glass_circle"/>
            </FrameLayout>
          </LinearLayout>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

    <TextView android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center" android:tag="preview_etikett" android:clickable="true" android:focusable="true" android:layout_marginTop="4dp"
        android:text="4 Gläser einlagern und Etiketten" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/brown_primary"/>

  </LinearLayout>
</FrameLayout>
