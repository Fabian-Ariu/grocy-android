<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="start|top"
      android:layout_marginStart="-110dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_orange" />
  <View android:layout_width="300dp" android:layout_height="300dp" android:layout_gravity="end|bottom"
      android:layout_marginEnd="-110dp" android:layout_marginBottom="120dp" android:background="@drawable/blob_blue" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rezepte" android:textColor="#1F1E1D" android:textSize="30sp" android:textStyle="bold"/>

    <!-- Segment-Umschalter -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp"
        android:orientation="horizontal" android:background="@drawable/glass_pill" android:padding="4dp">
      <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
          android:text="Fälliges zuerst" android:textColor="#1F1E1D" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/glass_chip"/>
      <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Kochbar" android:textColor="#5A5F6A" android:textSize="14sp"/>
      <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Alle" android:textColor="#5A5F6A" android:textSize="14sp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none"
        android:layout_marginTop="12dp" android:clipToPadding="false" android:paddingBottom="12dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/glass_card" android:padding="16dp" android:layout_marginBottom="12dp">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Overnight Oats" android:textColor="#1F1E1D" android:textSize="19sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alles da" android:textColor="#1F7A4D" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/badge_green" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="2 Port. · Joghurt fällig morgen" android:textColor="#6A6A6A" android:textSize="14sp"/>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/glass_card" android:padding="16dp" android:layout_marginBottom="12dp">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Milchreis" android:textColor="#1F1E1D" android:textSize="19sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alles da" android:textColor="#1F7A4D" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/badge_green" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="3 Port. · Milch fällig in 2 Tagen" android:textColor="#6A6A6A" android:textSize="14sp"/>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/glass_card" android:padding="16dp" android:layout_marginBottom="12dp">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Linsencurry" android:textColor="#1F1E1D" android:textSize="19sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 fehlt" android:textColor="#B4660A" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/badge_orange" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="4 Port. · Zwiebeln fehlen" android:textColor="#6A6A6A" android:textSize="14sp"/>
            </LinearLayout>
          </LinearLayout>
          <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/icon_circle_blue">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_add_shopping_cart" app:tint="#0062CC"/>
          </FrameLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/glass_card" android:padding="16dp">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gemüsesuppe" android:textColor="#1F1E1D" android:textSize="19sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 fehlen" android:textColor="#B4660A" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/badge_orange" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="4 Port. · Lauch, Sellerie fehlen" android:textColor="#6A6A6A" android:textSize="14sp"/>
            </LinearLayout>
          </LinearLayout>
          <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/icon_circle_blue">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_add_shopping_cart" app:tint="#0062CC"/>
          </FrameLayout>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="74dp" android:orientation="horizontal"
        android:background="@drawable/glass_card" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_barcode_scan" app:tint="#5A5F6A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scannen" android:textSize="11sp" android:textColor="#5A5F6A"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_inventory" app:tint="#5A5F6A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vorrat" android:textSize="11sp" android:textColor="#5A5F6A"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_local_grocery_store" app:tint="#5A5F6A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Einkauf" android:textSize="11sp" android:textColor="#5A5F6A"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/glass_chip">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_restaurant_menu" app:tint="#0062CC"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rezepte" android:textSize="11sp" android:textColor="#0062CC"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_round_widgets" app:tint="#5A5F6A"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mehr" android:textSize="11sp" android:textColor="#5A5F6A"/>
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>
</FrameLayout>
