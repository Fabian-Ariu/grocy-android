<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="end|top"
      android:layout_marginEnd="-110dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_violet" />
  <View android:layout_width="300dp" android:layout_height="300dp" android:layout_gravity="start|bottom"
      android:layout_marginStart="-90dp" android:layout_marginBottom="100dp" android:background="@drawable/blob_blue" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_circle" android:tag="preview_mehr" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_arrow_back" app:tint="#0062CC"/>
      </FrameLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Geräte" android:textColor="#1F1E1D" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wartung nach Herstellerangabe" android:textColor="#6A6A6A" android:textSize="13sp"/>
      </LinearLayout>
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/blue_fab">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="24sp"/>
      </FrameLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:layout_marginTop="14dp" android:clipToPadding="false" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kaffeemaschine" android:textColor="#1F1E1D" android:textSize="18sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Küche · Brühgruppe spülen: heute fällig" android:textColor="#C8781E" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_round_expand_more" app:tint="#8A8F98"/>
          </LinearLayout>

          <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal" android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:background="@drawable/blue_soft" android:layout_marginEnd="10dp" android:tag="preview_wartung" android:clickable="true" android:focusable="true">
              <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_round_edit" app:tint="#0062CC"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Anleitung" android:textColor="#0062CC" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Notiz" android:textColor="#3A3F4A" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/glass_chip"/>
          </LinearLayout>

          <TextView style="@style/PreviewSectionHeader" android:text="WARTUNG LAUT HERSTELLER" android:layout_marginTop="16dp"/>

          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/glass_chip" android:padding="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entkalken" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alle 90 Tage · laut Anleitung" android:textColor="#6A6A6A" android:textSize="13sp"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fällig in 5 Tagen" android:textColor="#6A6A6A" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/white_circle"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_round_done" app:tint="#1F7A4D"/></FrameLayout>
          </LinearLayout>

          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/glass_chip" android:padding="14dp" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Brühgruppe spülen" android:textColor="#1F1E1D" android:textSize="16sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wöchentlich · laut Anleitung" android:textColor="#6A6A6A" android:textSize="13sp"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heute fällig" android:textColor="#C8781E" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/white_circle"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_round_done" app:tint="#1F7A4D"/></FrameLayout>
          </LinearLayout>

          <TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:layout_marginTop="12dp" android:tag="preview_wartung" android:clickable="true" android:focusable="true"
              android:text="Wartung aus Anleitung hinzufügen" android:textColor="#0062CC" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/dashed_pill"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:layout_marginTop="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Geschirrspüler" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Küche · Siebe reinigen: fällig in 3 Tagen" android:textColor="#C8781E" android:textSize="13sp"/>
            </LinearLayout>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Backofen" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Küche" android:textColor="#6A6A6A" android:textSize="13sp"/>
            </LinearLayout>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Waschmaschine" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keller · Pflegewaschgang 90 °C: überfällig seit 2 Tagen" android:textColor="#C8781E" android:textSize="13sp"/>
            </LinearLayout>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_round_chevron_right" app:tint="#9AA0A8"/>
          </LinearLayout>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

  </LinearLayout>
</FrameLayout>
