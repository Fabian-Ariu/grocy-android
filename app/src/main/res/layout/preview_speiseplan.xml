<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="end|top"
      android:layout_marginEnd="-110dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_orange" />
  <View android:layout_width="300dp" android:layout_height="300dp" android:layout_gravity="start|bottom"
      android:layout_marginStart="-90dp" android:layout_marginBottom="100dp" android:background="@drawable/blob_green" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_circle" android:tag="preview_rezepte" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_arrow_back" app:tint="#0062CC"/>
      </FrameLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speiseplan" android:textColor="#1F1E1D" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Woche 19. bis 25. Oktober" android:textColor="#6A6A6A" android:textSize="13sp"/>
      </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/glass_card" android:layout_marginEnd="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mo" android:textColor="#6A6A6A" android:textSize="12sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19" android:textColor="#1F1E1D" android:textSize="18sp" android:textStyle="bold"/>
        <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:background="@drawable/dot_blue"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/glass_card" android:layout_marginEnd="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Di" android:textColor="#6A6A6A" android:textSize="12sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20" android:textColor="#1F1E1D" android:textSize="18sp" android:textStyle="bold"/>
        <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:background="@drawable/dot_blue"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/blue_cell" android:layout_marginEnd="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mi" android:textColor="#D6E6FF" android:textSize="12sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
        <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:background="@drawable/white_circle"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/glass_card" android:layout_marginEnd="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Do" android:textColor="#6A6A6A" android:textSize="12sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22" android:textColor="#1F1E1D" android:textSize="18sp" android:textStyle="bold"/>
        <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:background="@drawable/dot_blue"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/glass_card" android:layout_marginEnd="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fr" android:textColor="#6A6A6A" android:textSize="12sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23" android:textColor="#1F1E1D" android:textSize="18sp" android:textStyle="bold"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/glass_card" android:layout_marginEnd="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sa" android:textColor="#6A6A6A" android:textSize="12sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:textColor="#1F1E1D" android:textSize="18sp" android:textStyle="bold"/>
        <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:background="@drawable/dot_blue"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/glass_card">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="So" android:textColor="#6A6A6A" android:textSize="12sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textColor="#1F1E1D" android:textSize="18sp" android:textStyle="bold"/>
      </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:layout_marginTop="14dp" android:clipToPadding="false" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <TextView style="@style/PreviewSectionHeader" android:text="HEUTE, MITTWOCH"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card">
          <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:text="Mittag" android:textColor="#6A6A6A" android:textSize="14sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Linsencurry" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="1 fehlt" android:textColor="#C8781E" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/badge_amber" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
            </LinearLayout>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:text="Abend" android:textColor="#6A6A6A" android:textSize="14sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pasta mit Tomatensauce" android:textColor="#1F1E1D" android:textSize="17sp" android:textStyle="bold"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Alles da" android:textColor="#1F7A4D" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/badge_green" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
            </LinearLayout>
          </LinearLayout>
          <View style="@style/PreviewDivider"/>
          <TextView android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Rezept einplanen" android:textColor="#0062CC" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:background="@drawable/kassen_green_bg" android:padding="16dp">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vorschlag für Freitag" android:textColor="#1F7A4D" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.04"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Milchreis" android:textColor="#1F1E1D" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Braucht die Milch auf, die bald fällig ist" android:textColor="#3A3F4A" android:textSize="13sp"/>
          </LinearLayout>
          <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_green">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="26sp"/>
          </FrameLayout>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:tag="preview_einkauf" android:clickable="true" android:focusable="true" android:layout_marginTop="4dp"
        android:text="Fehlendes der Woche auf die Einkaufsliste" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/blue_primary"/>

  </LinearLayout>
</FrameLayout>
