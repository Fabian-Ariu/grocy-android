<?xml version="1.0" encoding="utf-8"?>
<!-- Scanory: Akku-Zeile (Vorlage 23) -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:paddingStart="16dp"
  android:paddingEnd="12dp"
  android:paddingTop="14dp"
  android:paddingBottom="14dp"
  android:background="@drawable/ripple_list_item_glass">
  <FrameLayout android:layout_width="34dp" android:layout_height="18dp" android:layout_marginStart="12dp" android:background="@drawable/batt_body">
    <View android:id="@+id/fill" android:layout_width="14dp" android:layout_height="12dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="2dp" android:background="@drawable/batt_fill_green"/>
  </FrameLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
    <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" tools:text="Rauchmelder Flur"/>
    <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" tools:text="Laden alle 90 Tage"/>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" tools:text="Faellig in 6 Tagen"/>
  </LinearLayout>
  <TextView android:id="@+id/button_charged" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:text="@string/action_charged" android:textColor="?attr/colorPrimary" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/blue_soft" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:clickable="true" android:focusable="true"/>
</LinearLayout>
