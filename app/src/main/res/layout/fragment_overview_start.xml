<layout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto">
  <data>
    <import type="android.view.View" />
    <import type="xyz.zedler.patrick.grocy.R" />
    <import type="xyz.zedler.patrick.grocy.Constants" />
    <import type="xyz.zedler.patrick.grocy.BuildConfig" />
    <variable
      name="viewModel"
      type="xyz.zedler.patrick.grocy.viewmodel.OverviewStartViewModel" />
    <variable
      name="fragment"
      type="xyz.zedler.patrick.grocy.fragment.OverviewStartFragment" />
    <variable
      name="activity"
      type="xyz.zedler.patrick.grocy.activity.MainActivity" />
    <variable
      name="clickUtil"
      type="xyz.zedler.patrick.grocy.util.ClickUtil" />
  </data>

  <RelativeLayout
    android:id="@+id/relative"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionGroup="true">

    <com.google.android.material.appbar.AppBarLayout
      android:id="@+id/app_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">


      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorError">

        <TextView
          style="@style/Widget.Grocy.TextView.LabelLarge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:layout_marginBottom="4dp"
          android:layout_gravity="center"
          android:visibility="@{viewModel.offlineLive ? View.VISIBLE : View.GONE}"
          android:textColor="?attr/colorOnError"
          android:text="@string/error_offline" />

      </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <xyz.zedler.patrick.grocy.view.swiperefreshlayout.CustomSwipeRefreshLayout
      android:id="@+id/swipe"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_below="@+id/app_bar"
      android:overScrollMode="never"
      app:setRefreshing="@{viewModel.isLoadingLive}"
      app:onRefreshListener="@{() -> viewModel.downloadData(true)}">

      <FrameLayout
        android:id="@+id/frame_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
          android:id="@+id/scroll"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:overScrollMode="never">

          <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="0dp"
            android:paddingBottom="24dp">

            <LinearLayout
              android:id="@+id/linear_container"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              app:layout_constraintTop_toTopOf="parent"
              app:layout_constraintWidth_max="@dimen/max_content_width"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent">

              <!-- Vorlage: kein Logo/Titel/Menue auf der Startseite, nur ein Verbindungs-Status oben rechts.
                   Einstellungen, Hilfe, Feedback liegen unter "Mehr". -->
              <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:paddingTop="6dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp">
                <Space
                  android:layout_width="0dp"
                  android:layout_height="1dp"
                  android:layout_weight="1" />
                <FrameLayout
                  android:layout_width="38dp"
                  android:layout_height="38dp"
                  android:background="@drawable/glass_chip"
                  android:contentDescription="@string/error_offline">
                  <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:background="@{viewModel.offlineLive ? @drawable/status_dot_grey : @drawable/status_dot_green}" />
                </FrameLayout>
              </LinearLayout>

              <!-- Scan-Hero (neues Design): grosser Scan-Knopf, scharf an den realen Scanner angebunden.
                   Tippen = Verbrauchen mit Scanner, lang druecken = Einlagern mit Scanner. -->
              <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="0dp"
                android:paddingBottom="10dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{() -> fragment.startConsumeScan()}"
                android:onLongClick="@{() -> fragment.startPurchaseScan()}">

                <FrameLayout
                  android:layout_width="112dp"
                  android:layout_height="112dp"
                  android:background="@drawable/scan_home_button_ring">

                  <FrameLayout
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_home_button_inner">

                    <ImageView
                      android:layout_width="36dp"
                      android:layout_height="36dp"
                      android:layout_gravity="center"
                      android:src="@drawable/ic_round_barcode_scan"
                      app:tint="#FFFFFF"
                      tools:ignore="ContentDescription" />

                  </FrameLayout>

                </FrameLayout>

                <TextView
                  style="@style/Widget.Grocy.TextView.TitleLarge"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:text="@string/action_scan" />


              </LinearLayout>

              <!-- Vorlage: Startseite = Scan-Hero + zwei Schnellzugriffe + kompakter Vorrats-Status.
                   Das alte Dashboard (Karten fuer Bestand/Einkauf/Rezepte/Hausarbeiten/Aufgaben/Stammdaten)
                   ist entfernt: diese Bereiche haben jetzt eigene Tabs. -->

              <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Grocy.Card.Text.Error"
                android:visibility="@{viewModel.storedPurchasesOnDevice ? View.VISIBLE : View.GONE}"
                android:onClick="@{() -> activity.navUtil.navigateDeepLink(@string/deep_link_storedPurchasesFragment)}"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:clickUtil="@{clickUtil}">

                <TextView
                  style="@style/Widget.Grocy.TextView"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:textColor="?attr/colorOnErrorContainer"
                  android:text="@string/msg_stored_purchases_overview" />

              </com.google.android.material.card.MaterialCardView>

              <!-- Schnellzugriffe (Vorlage): beide fuehren in den echten Einlagern-Ablauf -->
              <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp">
              <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/glass_card"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{() -> activity.navUtil.navigate(R.id.quickAddFragment)}">
                <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/icon_circle_green">
                  <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_round_restaurant_menu" app:tint="#1F7A4D" tools:ignore="ContentDescription" />
                </FrameLayout>
                <TextView style="@style/Widget.Grocy.TextView" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:maxLines="2" android:textAppearance="?attr/textAppearanceLabelLarge" android:textStyle="bold" android:text="@string/home_chip_produce" />
              </LinearLayout>

              <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/glass_card"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{() -> activity.navUtil.navigate(R.id.homemadeFragment)}">
                <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/icon_circle_brown">
                  <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_round_inventory" app:tint="#8A5A00" tools:ignore="ContentDescription" />
                </FrameLayout>
                <TextView style="@style/Widget.Grocy.TextView" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:maxLines="2" android:textAppearance="?attr/textAppearanceLabelLarge" android:textStyle="bold" android:text="@string/home_chip_homemade" />
              </LinearLayout>
              </LinearLayout>

              <!-- Dashboard (Vorlage-Stil): vier Kacheln mit Live-Daten, antippbar -->
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="10dp">
                <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="match_parent"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:minHeight="82dp"
                  android:padding="12dp"
                  android:layout_marginEnd="10dp"
                  android:background="@drawable/glass_card"
                  android:foreground="?attr/selectableItemBackground"
                  android:clickable="true"
                  android:focusable="true"
                  android:onClick="@{() -> activity.navUtil.navigate(R.id.stockOverviewFragment)}">
                  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/icon_circle_green">
                      <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:src="@drawable/ic_round_inventory" app:tint="#1F7A4D" tools:ignore="ContentDescription" />
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/tab_stock" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                  </LinearLayout>
                  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:text="@{viewModel.stockDescriptionTextLive ?? @string/home_nothing}" />
                </LinearLayout>
                <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="match_parent"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:minHeight="82dp"
                  android:padding="12dp"
                  
                  android:background="@drawable/glass_card"
                  android:foreground="?attr/selectableItemBackground"
                  android:clickable="true"
                  android:focusable="true"
                  android:onClick="@{() -> activity.navUtil.navigate(R.id.stockOverviewFragment)}">
                  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/icon_circle_orange">
                      <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:src="@drawable/ic_round_hourglass_bottom" app:tint="#C8781E" tools:ignore="ContentDescription" />
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/home_tile_due" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                  </LinearLayout>
                  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:text="@{viewModel.homeDueTextLive}" />
                </LinearLayout>
              </LinearLayout>
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
                <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="match_parent"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:minHeight="82dp"
                  android:padding="12dp"
                  android:layout_marginEnd="10dp"
                  android:background="@drawable/glass_card"
                  android:foreground="?attr/selectableItemBackground"
                  android:clickable="true"
                  android:focusable="true"
                  android:onClick="@{() -> activity.navUtil.navigateDeepLink(@string/deep_link_shoppingListFragment)}">
                  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/icon_circle_blue">
                      <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:src="@drawable/ic_round_local_grocery_store" app:tint="#0062CC" tools:ignore="ContentDescription" />
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/tab_shopping" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                  </LinearLayout>
                  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:text="@{viewModel.shoppingListDescriptionTextLive ?? @string/home_nothing}" />
                </LinearLayout>
                <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="match_parent"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:minHeight="82dp"
                  android:padding="12dp"
                  
                  android:background="@drawable/glass_card"
                  android:foreground="?attr/selectableItemBackground"
                  android:clickable="true"
                  android:focusable="true"
                  android:onClick="@{() -> activity.navUtil.navigateDeepLink(@string/deep_link_choresFragment)}">
                  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/icon_circle_violet">
                      <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:src="@drawable/ic_round_checklist" app:tint="#7C5CFF" tools:ignore="ContentDescription" />
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/title_chores" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                  </LinearLayout>
                  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:text="@{viewModel.homeChoresTextLive}" />
                </LinearLayout>
              </LinearLayout>

            </LinearLayout>

          </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

      </FrameLayout>

    </xyz.zedler.patrick.grocy.view.swiperefreshlayout.CustomSwipeRefreshLayout>

  </RelativeLayout>

</layout>