<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/relative" android:layout_width="match_parent" android:layout_height="match_parent">
  <com.google.android.material.appbar.AppBarLayout android:id="@+id/app_bar" android:background="@android:color/transparent" android:layout_width="match_parent" android:layout_height="wrap_content">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" style="@style/Widget.Grocy.Toolbar.Back" app:title="@string/maint_title"/>
    <TextView android:id="@+id/text_equipment" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="8dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp"/>
  </com.google.android.material.appbar.AppBarLayout>
  <LinearLayout android:id="@+id/bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="@dimen/global_scroll_bottom_padding">
    <TextView android:id="@+id/button_save" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:text="@string/maint_save" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/blue_primary" android:clickable="true" android:focusable="true"/>
  </LinearLayout>
  <FrameLayout android:id="@+id/container" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/app_bar" android:layout_above="@id/bottom">
    <androidx.core.widget.NestedScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
      <LinearLayout android:id="@+id/linear_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="16dp">
        <EditText android:id="@+id/edit_name" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:background="@drawable/input_box" android:hint="@string/maint_name_hint" android:inputType="textCapSentences" android:maxLines="1" android:textSize="17sp" android:textColor="?attr/colorOnSurface" android:textColorHint="?attr/colorOnSurfaceVariant" android:importantForAutofill="no"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginTop="12dp">
          <LinearLayout android:id="@+id/linear_suggestions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
        </HorizontalScrollView>
        <TextView style="@style/PreviewSectionHeader" android:layout_marginTop="16dp" android:text="@string/maint_rhythm"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:background="@drawable/glass_pill" android:padding="4dp">
          <TextView android:id="@+id/tab_after_last" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/maint_after_last" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/white_chip"/>
          <TextView android:id="@+id/tab_fixed" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/maint_fixed" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:background="@drawable/glass_card" android:paddingStart="18dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/maint_every" android:textColor="?attr/colorOnSurface" android:textSize="17sp"/>
          <TextView android:id="@+id/button_minus" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="–" android:textColor="?attr/colorOnSurface" android:textSize="22sp" android:background="@drawable/stepper_light" android:clickable="true" android:focusable="true"/>
          <TextView android:id="@+id/text_count" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="center" android:text="90" android:textColor="?attr/colorOnSurface" android:textSize="22sp" android:textStyle="bold"/>
          <TextView android:id="@+id/button_plus" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/blue_fab" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
          <TextView android:id="@+id/unit_days" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="@string/maint_unit_days" android:textColor="?attr/colorPrimary" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/chip_blue_selected" android:layout_marginEnd="10dp"/>
          <TextView android:id="@+id/unit_weeks" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="@string/maint_unit_weeks" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:background="@drawable/glass_pill" android:layout_marginEnd="10dp"/>
          <TextView android:id="@+id/unit_months" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="@string/maint_unit_months" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:background="@drawable/glass_pill"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginTop="14dp" android:background="@drawable/input_box">
          <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_round_edit" app:tint="?attr/colorOutline" android:contentDescription="@string/maint_note_hint"/>
          <EditText android:id="@+id/edit_note" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@android:color/transparent" android:hint="@string/maint_note_hint" android:inputType="text" android:maxLines="1" android:textSize="16sp" android:textColor="?attr/colorOnSurface" android:textColorHint="?attr/colorOnSurfaceVariant" android:importantForAutofill="no"/>
        </LinearLayout>
        <TextView android:id="@+id/text_explain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
  </FrameLayout>
</RelativeLayout>
