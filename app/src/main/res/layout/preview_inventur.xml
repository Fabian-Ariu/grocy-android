<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F0EB">

  <View android:layout_width="320dp" android:layout_height="320dp" android:layout_gravity="start|top"
      android:layout_marginStart="-100dp" android:layout_marginTop="-30dp" android:background="@drawable/blob_blue" />
  <View android:layout_width="300dp" android:layout_height="300dp" android:layout_gravity="end|bottom"
      android:layout_marginEnd="-90dp" android:layout_marginBottom="80dp" android:background="@drawable/blob_green" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/glass_circle" android:tag="preview_mehr" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_round_arrow_back" app:tint="#0062CC"/>
      </FrameLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inventur" android:textColor="#1F1E1D" android:textSize="24sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keller" android:textColor="#1F7A4D" android:textSize="14sp" android:textStyle="bold"/>
          <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_round_expand_more" app:tint="#1F7A4D"/>
        </LinearLayout>
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:tag="preview_mehr" android:clickable="true" android:focusable="true"
          android:text="Beenden" android:textColor="#0062CC" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/glass_pill"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" android:background="@drawable/glass_card" android:padding="14dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2 von 6 geprüft" android:textColor="#1F1E1D" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 korrigiert" android:textColor="#6A6A6A" android:textSize="14sp"/>
      </LinearLayout>
      <FrameLayout android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp" android:background="@drawable/progress_track">
        <View android:layout_width="120dp" android:layout_height="8dp" android:background="@drawable/progress_fill"/>
      </FrameLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" android:background="@drawable/kassen_green_bg" android:padding="20dp">
      <TextView style="@style/PreviewSectionHeader" android:text="GESCANNT"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Passata" android:textColor="#1F1E1D" android:textSize="30sp" android:textStyle="bold"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Laut Grocy: 6 Gläser" android:textColor="#3A3F4A" android:textSize="15sp"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
        <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="–" android:textColor="#3A3F4A" android:textSize="26sp" android:background="@drawable/stepper_light"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#1F1E1D" android:textSize="42sp" android:textStyle="bold"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="stimmt" android:textColor="#1F7A4D" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="+" android:textColor="#3A3F4A" android:textSize="26sp" android:background="@drawable/stepper_light"/>
      </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:tag="preview_mehr" android:clickable="true" android:focusable="true" android:layout_marginTop="14dp"
        android:text="Stimmt · weiter" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/green_primary"/>

    <TextView style="@style/PreviewSectionHeader" android:text="NOCH NICHT GESCANNT" android:layout_marginTop="18dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
      <TextView android:layout_width="wrap_content" android:layout_height="42dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Kidneybohnen" android:textColor="#1F1E1D" android:textSize="14sp" android:background="@drawable/glass_pill" android:layout_marginEnd="10dp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="42dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Linsen" android:textColor="#1F1E1D" android:textSize="14sp" android:background="@drawable/glass_pill" android:layout_marginEnd="10dp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="42dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Zwetschgenmus" android:textColor="#1F1E1D" android:textSize="14sp" android:background="@drawable/glass_pill"/>
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="42dp" android:layout_gravity="center_horizontal" android:orientation="horizontal" android:gravity="center"
        android:paddingStart="14dp" android:paddingEnd="16dp" android:background="@drawable/glass_chip">
      <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_round_barcode" app:tint="#6A6A6A"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Nächster Scan = stimmt · Lautstärke ± korrigiert" android:textColor="#6A6A6A" android:textSize="13sp"/>
    </LinearLayout>

  </LinearLayout>
</FrameLayout>
